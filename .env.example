# Public Facturance Plus website (facturance.com).
#
# This application serves marketing pages only. Login, signup and every
# authenticated screen belong to the client application on its own origin, so
# the website never authenticates anyone and never holds a session.

# Reserved for public marketing features that genuinely need the API, such as
# a contact form. Nothing on the website authenticates through it.
# Production: https://api.plus.facturance.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001

# Where "Connexion" and "Essayer gratuitement" send visitors. The client
# application's Vite dev server listens on 5174.
# Production: https://client.plus.facturance.com
NEXT_PUBLIC_CLIENT_APP_BASE_URL=http://localhost:5174
