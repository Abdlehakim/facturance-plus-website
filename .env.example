# Public Facturance Plus website (facturance.com).
#
# This application serves marketing pages only. Login, signup and every
# authenticated screen belong to the client application on its own origin, so
# the website never authenticates anyone and never holds a session.

# Where "Connexion" and "Essayer gratuitement" send visitors. The client
# application's Vite dev server listens on 5174.
# Production: https://client.plus.facturance.com
NEXT_PUBLIC_CLIENT_APP_BASE_URL=http://localhost:5174

# Where /nos-clients reads the public company directory from.
#
# SERVER SIDE ONLY - deliberately without the NEXT_PUBLIC_ prefix, so the
# API origin is never inlined into a browser bundle. Only the public,
# unauthenticated showcase endpoint is called; the website still holds no
# session and no credential.
# Must include the API's global /api prefix: the page appends
# /public/showcase to this value.
#
# Production is set by compose.production.yaml, which defaults to
# http://api:3101/api - the api service on the internal network, so the
# request never leaves it. Override with WEBSITE_FACTURANCE_API_BASE_URL.
#
# With NODE_ENV=production and this variable absent or malformed, the page
# fails closed: it shows the unavailable state and no company. It never
# falls back to the development address below.
FACTURANCE_API_BASE_URL=http://127.0.0.1:3101/api
